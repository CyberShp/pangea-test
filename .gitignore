# 旧版托管目录（兼容 PR #3）
runs/*
!runs/.gitkeep

# 预设空间：保留目录说明，忽略用户源码、输入、中间件与输出
/source/*
!/source/README.md
/inputs/*
!/inputs/README.md
/workspace/*
!/workspace/README.md
/outputs/*
!/outputs/README.md

# 项目配置通常属于本地环境；保留说明和示例
/projects/*
!/projects/README.md
!/projects/example.project.json

# 资产 Catalog 为确定性生成物，资产源文件本身可版本管理
/assets/catalog.json

# Python 临时文件
__pycache__/
*.pyc
