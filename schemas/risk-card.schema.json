{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGEA Canonical Risk Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "risk_id", "title", "dfx", "severity", "confidence", "trigger", "propagation", "external_impact", "observation", "recovery", "translation_status", "evidence"],
  "properties": {
    "artifact_type": {"const": "risk_card"},
    "schema_version": {"const": "1.0"},
    "risk_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "title": {"type": "string", "minLength": 1},
    "dfx": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["功能与状态", "资源与规格", "性能与压力", "并发与异常", "升级与兼容", "可靠性与一致性"]
      },
      "uniqueItems": true
    },
    "severity": {"enum": ["Low", "Medium", "High", "Critical"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "trigger": {"type": "string", "minLength": 1},
    "propagation": {"type": "string", "minLength": 1},
    "external_impact": {"type": "string", "minLength": 1},
    "observation": {"type": "string", "minLength": 1},
    "recovery": {"type": "string", "minLength": 1},
    "translation_status": {"enum": ["Blackbox-ready", "Graybox-ready", "Developer-confirm"]},
    "test_explanation": {"type": "string", "minLength": 1},
    "source_scope": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "inference": {"type": ["string", "null"]},
    "instrumentation_request": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["requested_point", "control_semantics", "parameters", "observation", "recovery_requirement"],
      "properties": {
        "requested_point": {"type": "string", "minLength": 1},
        "control_semantics": {"type": "string", "minLength": 1},
        "parameters": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "recovery_requirement": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "observation"],
        "properties": {
          "location": {"type": "string", "pattern": "\\S"},
          "observation": {"type": "string", "pattern": "\\S"}
        }
      }
    },
    "coverage_gap": {"type": ["string", "null"]},
    "related_risk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "status": {"enum": ["open", "covered", "confirmed", "dismissed"]}
  }
}
