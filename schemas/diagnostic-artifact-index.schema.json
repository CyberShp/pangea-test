{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pangea-test.local/schemas/diagnostic-artifact-index.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "run_id", "state", "artifacts"],
  "properties": {
    "artifact_type": {"const": "diagnostic_artifact_index"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"const": "committed"},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "log_summary": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"path": {"const": "internal/diagnostics/log-summary.json"}}}]},
        "pcap_summary": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"path": {"const": "internal/diagnostics/pcap-summary.json"}}}]},
        "failure_classification": {"allOf": [{"$ref": "#/$defs/record"}, {"properties": {"path": {"const": "internal/diagnostics/failure-classification.json"}}}]}
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "input_sha256", "body_sha256", "content_sha256", "state"],
      "properties": {
        "path": {"type": "string"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state": {"const": "committed"}
      }
    }
  }
}
