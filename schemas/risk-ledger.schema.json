{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGEA Risk Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "updated_at", "risks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string"},
    "risks": {"type": "array", "items": {"$ref": "#/$defs/riskCard"}},
    "r2_projection": {"$ref":"#/$defs/r2Projection"}
  },
  "$defs": {
    "hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "contributionProjection":{"type":"object","additionalProperties":false,"required":["ids","sha256"],"properties":{"ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^C-[a-f0-9]{16}$"}},"sha256":{"$ref":"#/$defs/hash"}}},
    "r2Projection":{"type":"object","additionalProperties":false,"required":["merged_sha256","fragment_ids","fragment_sha256s","contributions","hc_risks"],"properties":{"merged_sha256":{"$ref":"#/$defs/hash"},"fragment_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"fragment_sha256s":{"type":"object","additionalProperties":{"$ref":"#/$defs/hash"}},"contributions":{"type":"object","additionalProperties":false,"required":["flows","branches","states","resources","concurrency","error_chains","scenario_candidates","coverage"],"properties":{"flows":{"$ref":"#/$defs/contributionProjection"},"branches":{"$ref":"#/$defs/contributionProjection"},"states":{"$ref":"#/$defs/contributionProjection"},"resources":{"$ref":"#/$defs/contributionProjection"},"concurrency":{"$ref":"#/$defs/contributionProjection"},"error_chains":{"$ref":"#/$defs/contributionProjection"},"scenario_candidates":{"$ref":"#/$defs/contributionProjection"},"coverage":{"$ref":"#/$defs/contributionProjection"}}},"hc_risks":{"type":"object","additionalProperties":false,"required":["ids","sha256"],"properties":{"ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^R-[a-f0-9]{16}$"}},"sha256":{"$ref":"#/$defs/hash"}}}}},
    "riskCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "risk_id", "title", "dfx", "severity", "confidence", "trigger", "propagation", "external_impact", "observation", "recovery", "translation_status", "evidence"],
      "properties": {
        "artifact_type": {"const": "risk_card"},
        "schema_version": {"const": "1.0"},
        "risk_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "dfx": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["功能与状态", "资源与规格", "性能与压力", "并发与异常", "升级与兼容", "可靠性与一致性"]},
          "uniqueItems": true
        },
        "severity": {"enum": ["Low", "Medium", "High", "Critical"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "trigger": {"type": "string", "minLength": 1},
        "propagation": {"type": "string", "minLength": 1},
        "external_impact": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "translation_status": {"enum": ["Blackbox-ready", "Graybox-ready", "Developer-confirm"]},
        "test_explanation": {"type": "string", "minLength": 1},
        "source_scope": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["repository", "ref"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "ref": {"type": "string", "minLength": 1}
          }
        },
        "inference": {"type": ["string", "null"]},
        "instrumentation_request": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["requested_point", "control_semantics", "parameters", "observation", "recovery_requirement"],
          "properties": {
            "requested_point": {"type": "string", "minLength": 1},
            "control_semantics": {"type": "string", "minLength": 1},
            "parameters": {"type": "string", "minLength": 1},
            "observation": {"type": "string", "minLength": 1},
            "recovery_requirement": {"type": "string", "minLength": 1}
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["location", "observation"],
            "properties": {
              "location": {"type": "string", "pattern": "\\S"},
              "observation": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "coverage_gap": {"type": ["string", "null"]},
        "related_risk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "status": {"enum": ["open", "covered", "confirmed", "dismissed"]}
      }
    }
  }
}
