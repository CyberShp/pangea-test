{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "receipt", "signature"],
  "properties": {
    "artifact_type": {"const": "role_execution_attestation"},
    "schema_version": {"const": "1.0"},
    "signature": {"type": "string", "pattern": "^[a-f0-9]{128}$"},
    "receipt": {
      "type": "object",
      "$comment": "Replay validation additionally enforces model_calls_completed <= model_requests_admitted <= model_call_limit.",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "captured_by", "agent", "logical_role", "execution_agent", "model", "opencode_version", "cwd_manifest_sha256", "artifact_bindings", "command_sha256", "overlay_sha256", "resolved_config_sha256", "resolved_permission_rules_sha256", "output_payload_sha256", "model_call_limit", "model_budget_hook_sha256", "model_calls_completed", "model_requests_admitted", "pre_request_budget_blocked", "pre_request_budget_enforced", "injected_test_runner", "evidence_class", "plugin_closure", "resolved_plugin_closure", "session_id", "stdout_sha256", "exit_code", "passed", "failures"],
      "properties": {
        "artifact_type": {"const": "role_execution_receipt"},
        "schema_version": {"const": "1.0"},
        "captured_by": {"const": "evaluator"},
        "agent": {"enum": ["analysis-worker", "auditor", "mr-reader"]},
        "logical_role": {"enum": ["analysis-worker", "auditor", "mr-reader"]},
        "execution_agent": {"enum": ["analysis-worker", "analysis-leaf", "auditor", "audit-leaf", "mr-reader"]},
        "model": {"const": "deepseek/deepseek-v4-flash"},
        "opencode_version": {"const": "1.18.4"},
        "cwd_manifest_sha256": {"$ref": "#/$defs/hash"},
        "artifact_bindings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "payload_sha256", "file_sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "payload_sha256": {"$ref": "#/$defs/hash"},
              "file_sha256": {"$ref": "#/$defs/hash"}
            }
          }
        },
        "command_sha256": {"$ref": "#/$defs/hash"},
        "overlay_sha256": {"$ref": "#/$defs/hash"},
        "resolved_config_sha256": {"$ref": "#/$defs/hash"},
        "resolved_permission_rules_sha256": {"$ref": "#/$defs/hash"},
        "output_payload_sha256": {"$ref": "#/$defs/hash"},
        "model_call_limit": {"type": "integer", "minimum": 1, "maximum": 40},
        "model_budget_hook_sha256": {"$ref": "#/$defs/hash"},
        "model_calls_completed": {"type": "integer", "minimum": 1, "maximum": 40},
        "model_requests_admitted": {"type": "integer", "minimum": 1, "maximum": 40},
        "pre_request_budget_blocked": {"const": false},
        "pre_request_budget_enforced": {"type": "boolean"},
        "injected_test_runner": {"type": "boolean"},
        "evidence_class": {"enum": ["production", "test-only"]},
        "plugin_closure": {
          "allOf": [{"$ref": "#/$defs/pluginClosure"}],
          "unevaluatedProperties": false
        },
        "resolved_plugin_closure": {
          "allOf": [
            {"$ref": "#/$defs/pluginClosure"},
            {
              "type": "object",
              "required": ["parsed", "resolved_plugin_count", "exact"],
              "properties": {
                "parsed": {"const": true},
                "resolved_plugin_count": {"const": 1},
                "exact": {"const": true}
              }
            }
          ],
          "unevaluatedProperties": false
        },
        "session_id": {"type": "string", "minLength": 1},
        "stdout_sha256": {"$ref": "#/$defs/hash"},
        "exit_code": {"const": 0},
        "passed": {"const": true},
        "failures": {"const": []}
      },
      "oneOf": [
        {
          "properties": {
            "injected_test_runner": {"const": false},
            "pre_request_budget_enforced": {"const": true},
            "evidence_class": {"const": "production"}
          }
        },
        {
          "properties": {
            "injected_test_runner": {"const": true},
            "pre_request_budget_enforced": {"const": false},
            "evidence_class": {"const": "test-only"}
          }
        }
      ],
      "allOf": [
        {
          "if": {"properties": {"execution_agent": {"const": "analysis-leaf"}}, "required": ["execution_agent"]},
          "then": {
            "properties": {
              "agent": {"const": "analysis-worker"},
              "logical_role": {"const": "analysis-worker"},
              "model_call_limit": {"const": 1},
              "model_calls_completed": {"const": 1},
              "model_requests_admitted": {"const": 1},
              "pre_request_budget_blocked": {"const": false},
              "artifact_bindings": {
                "minItems": 1, "maxItems": 1,
                "items": {"properties": {"name": {"const": "COMPACT_CONTEXT.json"}}}
              }
            }
          }
        },
        {
          "if": {"properties": {"execution_agent": {"const": "audit-leaf"}}, "required": ["execution_agent"]},
          "then": {
            "properties": {
              "agent": {"const": "auditor"},
              "logical_role": {"const": "auditor"},
              "model_call_limit": {"const": 1},
              "model_calls_completed": {"const": 1},
              "model_requests_admitted": {"const": 1},
              "pre_request_budget_blocked": {"const": false},
              "artifact_bindings": {
                "minItems": 1, "maxItems": 1,
                "items": {"properties": {"name": {"const": "SEMANTIC_BATCH.json"}}}
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pluginClosure": {
      "type": "object",
      "required": ["plugin_uri", "plugin_sha256", "plugin_count", "plugin_array_sha256"],
      "properties": {
        "plugin_uri": {"const": "file://{ISOLATED_EVALUATOR_ROOT}/model-budget-hook/pre-request-budget.js"},
        "plugin_sha256": {"$ref": "#/$defs/hash"},
        "plugin_count": {"const": 1},
        "plugin_array_sha256": {"const": "47834b06fb6e359d73b95c7b313ae33e364d82a256d975c6c29145835891d18d"}
      }
    }
  }
}
