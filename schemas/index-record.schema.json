{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGEA GitNexus Index Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "repository", "started_at", "ended_at", "duration_seconds", "status", "index_mode", "source_commit", "shadow_commit", "gitnexus", "statistics", "failure", "degradation", "baseline"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "gitnexus_index"},
    "repository": {"type": "string", "minLength": 1},
    "source_repository": {"type": "string"},
    "shadow_repository": {"type": "string"},
    "source_commit": {"type": ["string", "null"]},
    "shadow_commit": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "status": {"enum": ["indexed", "unchanged", "skipped", "failed"]},
    "index_mode": {"enum": ["cold", "updated", "unchanged", "retry", null]},
    "gitnexus": {"type": "object"},
    "statistics": {"type": "object"},
    "failure": {"type": ["string", "null"]},
    "degradation": {"type": ["string", "null"]},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usable", "reason"],
      "properties": {
        "usable": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "record_path": {"type": "string"}
  }
}
