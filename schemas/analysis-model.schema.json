          },
          "external_construction": {
            "type": "string",
            "minLength": 1
          },
          "injection": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "retained",
              "merged",
              "untestable",
              "out_of_scope",
              "blocked"
            ]
          },
          "target_ids": {
            "type": "array"
          }
        }
      }
    },
    "sfmea": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sfmea_id",
          "title",
          "source_refs",
          "failure_mode",
          "cause",
          "local_effect",
          "external_effect",
          "detection",
          "recovery",
          "severity",
