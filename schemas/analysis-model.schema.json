{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGEA Complete Analysis Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "run_id",
    "analysis_depth",
    "source_commits",
    "evidence_consumption",
    "entrypoints",
    "flows",
    "branches",
    "states",
    "resources",
    "concurrency",
    "error_chains",
    "collection_applicability",
    "model_applicability",
    "scenario_candidates",
    "sfmea",
    "test_scenarios",
    "test_flows",
    "test_cases",
    "traceability",
    "coverage_dispositions",
    "depth_limitations",
    "unresolved"
  ],
  "properties": {
    "artifact_type": {
      "const": "analysis_model"
    },
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_depth": {
      "enum": [
        "complete",
        "fast"
      ]
    },
    "source_commits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "evidence_consumption": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "source_ref",
          "status",
          "parser",
          "consumed_ranges",
          "conclusions",
          "used_by",
          "unread_ranges",
          "limitations"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "parsed",
              "partially_parsed",
              "blocked",
              "out_of_scope",
              "unreadable"
            ]
          },
          "parser": {
            "type": "string",
            "minLength": 1
          },
          "consumed_ranges": {
            "type": "array"
          },
          "conclusions": {
            "type": "array"
          },
          "used_by": {
            "type": "array"
          },
          "unread_ranges": {
            "type": "array"
          },
          "limitations": {
            "type": "array"
          }
        }
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entrypoint_id",
          "title",
          "external_trigger",
          "registration",
          "preconditions",
          "flow_ids",
          "status",
          "disposition_reason",
          "source_evidence"
        ],
        "properties": {
          "entrypoint_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "external_trigger": {
            "type": "string",
            "minLength": 1
          },
          "registration": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "string",
            "minLength": 1
          },
          "flow_ids": {
            "type": "array"
          },
          "status": {
            "enum": [
              "analyzed",
              "covered_by_other",
              "not_applicable",
              "blocked",
              "need_verify",
              "truncated"
            ]
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          },
          "source_evidence": {
            "type": "array"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flow_id",
          "title",
          "priority",
          "external_trigger",
          "entrypoint_id",
          "registration",
          "preconditions",
          "normal_path",
          "decisions",
          "abnormal_paths",
          "state_changes",
          "resource_lifecycle",
          "timeout_retry_recovery",
          "concurrency",
          "error_propagation",
          "latent_or_secondary_failures",
          "blackbox_controls",
          "oracles",
          "source_evidence",
          "status",
          "disposition_reason"
        ],
        "properties": {
          "flow_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "minLength": 1
          },
          "external_trigger": {
            "type": "string",
            "minLength": 1
          },
          "entrypoint_id": {
            "type": "string",
            "minLength": 1
          },
          "registration": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "string",
            "minLength": 1
          },
          "normal_path": {
            "type": "array"
          },
          "decisions": {
            "type": "array"
          },
          "abnormal_paths": {
            "type": "array"
          },
          "state_changes": {
            "type": "array"
          },
          "resource_lifecycle": {
            "type": "array"
          },
          "timeout_retry_recovery": {
            "type": "array"
          },
          "concurrency": {
            "type": "array"
          },
          "error_propagation": {
            "type": "array"
          },
          "latent_or_secondary_failures": {
            "type": "array"
          },
          "blackbox_controls": {
            "type": "array"
          },
          "oracles": {
            "type": "array"
          },
          "source_evidence": {
            "type": "array"
          },
          "status": {
            "enum": [
              "analyzed",
              "covered_by_other",
              "not_applicable",
              "blocked",
              "need_verify",
              "truncated"
            ]
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch_id",
          "flow_id",
          "condition",
          "true_path",
          "false_path",
          "external_effect",
          "controllability",
          "observability",
          "source_evidence",
          "status",
          "disposition_reason"
        ],
        "properties": {
          "branch_id": {
            "type": "string",
            "minLength": 1
          },
          "flow_id": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "true_path": {
            "type": "string",
            "minLength": 1
          },
          "false_path": {
            "type": "string",
            "minLength": 1
          },
          "external_effect": {
            "type": "string",
            "minLength": 1
          },
          "controllability": {
            "type": "string",
            "minLength": 1
          },
          "observability": {
            "type": "string",
            "minLength": 1
          },
          "source_evidence": {
            "type": "array"
          },
          "status": {
            "enum": [
              "analyzed",
              "covered_by_other",
              "not_applicable",
              "blocked",
              "need_verify",
              "truncated"
            ]
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_id",
          "title",
          "initial_state",
          "transitions",
          "illegal_transitions",
          "external_controls",
          "observables",
          "source_evidence",
          "status",
          "disposition_reason"
        ],
        "properties": {
          "state_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "initial_state": {
            "type": "string",
            "minLength": 1
          },
          "transitions": {
            "type": "array"
          },
          "illegal_transitions": {
            "type": "array"
          },
          "external_controls": {
            "type": "array"
          },
          "observables": {
            "type": "array"
          },
          "source_evidence": {
            "type": "array"
          },
          "status": {
            "enum": [
              "analyzed",
              "covered_by_other",
              "not_applicable",
              "blocked",
              "need_verify",
              "truncated"
            ]
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_id",
          "title",
          "acquire",
          "owner",
          "release",
          "abnormal_cleanup",
          "invariant",
          "limits",
          "recovery",
          "source_evidence",
          "status",
          "disposition_reason"
        ],
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "acquire": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "release": {
            "type": "string",
            "minLength": 1
          },
          "abnormal_cleanup": {
            "type": "string",
            "minLength": 1
          },
          "invariant": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "array"
          },
          "recovery": {
            "type": "string",
            "minLength": 1
          },
          "source_evidence": {
            "type": "array"
          },
          "status": {
            "enum": [
              "analyzed",
              "covered_by_other",
              "not_applicable",
              "blocked",
              "need_verify",
              "truncated"
            ]
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "concurrency": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concurrency_id",
          "title",
          "actors",
          "shared_state",
          "ordering",
          "race_windows",
          "cancellation",
          "recovery",
          "source_evidence",
          "status",
          "disposition_reason"
        ],
        "properties": {
          "concurrency_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "actors": {
            "type": "array"
          },
          "shared_state": {
            "type": "array"
          },
          "ordering": {
            "type": "array"
          },
          "race_windows": {
            "type": "array"
          },
          "cancellation": {
            "type": "array"
          },
          "recovery": {
            "type": "string",
            "minLength": 1
          },
          "source_evidence": {
            "type": "array"
          },
          "status": {
            "enum": [
              "analyzed",
              "covered_by_other",
              "not_applicable",
              "blocked",
              "need_verify",
              "truncated"
            ]
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "error_chains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chain_id",
          "title",
          "trigger",
          "propagation",
          "masking",
          "terminal_effect",
          "recovery",
          "source_evidence",
          "status",
          "disposition_reason"
        ],
        "properties": {
          "chain_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "propagation": {
            "type": "array"
          },
          "masking": {
            "type": "string",
            "minLength": 1
          },
          "terminal_effect": {
            "type": "string",
            "minLength": 1
          },
          "recovery": {
            "type": "string",
            "minLength": 1
          },
          "source_evidence": {
            "type": "array"
          },
          "status": {
            "enum": [
              "analyzed",
              "covered_by_other",
              "not_applicable",
              "blocked",
              "need_verify",
              "truncated"
            ]
          },
          "disposition_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "collection_applicability": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collection",
          "disposition",
          "reason",
          "evidence"
        ],
        "properties": {
          "collection": {
            "enum": [
              "states",
              "resources",
              "concurrency",
              "error_chains",
              "scenario_candidates"
            ]
          },
          "disposition": {
            "enum": [
              "applicable",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 8
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "fact_keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^OBL-[a-f0-9]{16}$"
                },
                {
                  "type": "string",
                  "pattern": "^INV-[a-f0-9]{16}$"
                },
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            }
          }
        }
      }
    },
    "model_applicability": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dfx",
          "applicable",
          "reason",
          "evidence"
        ],
        "properties": {
          "dfx": {
            "type": "string",
            "minLength": 1
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenario_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "title",
          "drivers",
          "source_refs",
          "failure_mechanism",
          "external_construction",
          "injection",
          "oracle",
          "disposition",
          "target_ids"
        ],
        "properties": {
