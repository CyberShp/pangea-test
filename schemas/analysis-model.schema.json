            "minLength": 1
          },
          "source_candidate_ids": {
            "type": "array"
          },
          "risk_ids": {
            "type": "array"
          },
          "preconditions": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "array"
          },
          "cleanup": {
            "type": "string",
            "minLength": 1
          }
        }
