              "High",
              "Critical"
            ]
          },
          "scenario_ids": {
            "type": "array"
          },
          "test_case_ids": {
            "type": "array"
          }
        }
      }
    },
    "test_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
