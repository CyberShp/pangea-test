{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PANGEA isolated public corpus manifest",
  "type": "object",
  "required": ["schema_version", "visibility", "repositories"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "visibility": {"const": "public-to-candidate"},
    "description": {"type": "string"},
    "repositories": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "url", "commit", "tree", "mount", "read_only"],
        "properties": {
          "id": {"type": "string"},
          "url": {
            "type": "string",
            "pattern": "^(?:https://[^/]+/.+|ssh://git@[^/]+/.+|git@[^:]+:.+?)(?:\\.git)?/?$"
          },
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "mount": {"type": "string"},
          "read_only": {"const": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
